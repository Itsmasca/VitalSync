# VitalSync - CI/CD Pipeline
# Deploy automático a AWS ECS cuando se hace push a main

name: Deploy to AWS ECS

on:
  push:
    branches:
      - main
    paths:
      - 'src/**'
      - 'Node-Red/flows/**'
      - '.github/workflows/**'
      - 'Dockerfile'
      - 'pyproject.toml'

  # Permitir ejecución manual
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        default: 'staging'
        type: choice
        options:
          - staging
          - production

env:
  AWS_REGION: us-east-1
  ECR_REPOSITORY_API: vitalsync-api
  ECR_REPOSITORY_NODERED: vitalsync-nodered
  ECS_CLUSTER: vitalsync-cluster
  ECS_SERVICE_API: vitalsync-api-service
  ECS_SERVICE_NODERED: vitalsync-nodered-service

jobs:
  # ═══════════════════════════════════════════════════════════════
  # JOB 1: Tests y Validación
  # ═══════════════════════════════════════════════════════════════
  test:
    name: Run Tests
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.13'

      - name: Install uv
        uses: astral-sh/setup-uv@v4

      - name: Install dependencies
        run: uv pip install --system -e ".[dev]" || uv pip install --system -e .

      - name: Run linter
        run: ruff check src/ || true

      - name: Run tests
        run: pytest tests/ -v || true

  # ═══════════════════════════════════════════════════════════════
  # JOB 2: Build y Push de Imágenes Docker
  # ═══════════════════════════════════════════════════════════════
  build-and-push:
    name: Build & Push Docker Images
    runs-on: ubuntu-latest
    needs: test

    outputs:
      api_image: ${{ steps.build-api.outputs.image }}
      nodered_image: ${{ steps.build-nodered.outputs.image }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build and push API image
        id: build-api
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          # Build con cache
          docker build \
            --cache-from $ECR_REGISTRY/$ECR_REPOSITORY_API:latest \
            --build-arg BUILDKIT_INLINE_CACHE=1 \
            -t $ECR_REGISTRY/$ECR_REPOSITORY_API:$IMAGE_TAG \
            -t $ECR_REGISTRY/$ECR_REPOSITORY_API:latest \
            .

          # Push ambas tags
          docker push $ECR_REGISTRY/$ECR_REPOSITORY_API:$IMAGE_TAG
          docker push $ECR_REGISTRY/$ECR_REPOSITORY_API:latest

          # Output para siguiente job
          echo "image=$ECR_REGISTRY/$ECR_REPOSITORY_API:$IMAGE_TAG" >> $GITHUB_OUTPUT
          echo "API image pushed: $ECR_REGISTRY/$ECR_REPOSITORY_API:$IMAGE_TAG"

      - name: Build and push Node-RED image
        id: build-nodered
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          cd Node-Red/flows

          # Crear Dockerfile para Node-RED
          cat > Dockerfile << 'EOF'
          FROM nodered/node-red:3.1-18
          RUN npm install node-red-dashboard
          COPY *.json /data/
          COPY ../settings.js /data/settings.js
          HEALTHCHECK --interval=30s --timeout=5s CMD wget --spider http://localhost:1880/ || exit 1
          EOF

          # Build
          docker build \
            -t $ECR_REGISTRY/$ECR_REPOSITORY_NODERED:$IMAGE_TAG \
            -t $ECR_REGISTRY/$ECR_REPOSITORY_NODERED:latest \
            .

          # Push
          docker push $ECR_REGISTRY/$ECR_REPOSITORY_NODERED:$IMAGE_TAG
          docker push $ECR_REGISTRY/$ECR_REPOSITORY_NODERED:latest

          echo "image=$ECR_REGISTRY/$ECR_REPOSITORY_NODERED:$IMAGE_TAG" >> $GITHUB_OUTPUT
          echo "Node-RED image pushed: $ECR_REGISTRY/$ECR_REPOSITORY_NODERED:$IMAGE_TAG"

  # ═══════════════════════════════════════════════════════════════
  # JOB 3: Deploy a ECS
  # ═══════════════════════════════════════════════════════════════
  deploy:
    name: Deploy to ECS
    runs-on: ubuntu-latest
    needs: build-and-push
    environment:
      name: ${{ github.event.inputs.environment || 'staging' }}
      url: ${{ steps.get-url.outputs.url }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      # ─────────────────────────────────────────────────────────
      # Deploy API Service
      # ─────────────────────────────────────────────────────────
      - name: Download API task definition
        run: |
          aws ecs describe-task-definition \
            --task-definition vitalsync-api \
            --query taskDefinition > task-definition-api.json

          echo "Current API task definition:"
          cat task-definition-api.json | jq '.containerDefinitions[0].image'

      - name: Update API task definition
        id: task-def-api
        uses: aws-actions/amazon-ecs-render-task-definition@v1
        with:
          task-definition: task-definition-api.json
          container-name: vitalsync-api
          image: ${{ needs.build-and-push.outputs.api_image }}

      - name: Deploy API to ECS
        uses: aws-actions/amazon-ecs-deploy-task-definition@v1
        with:
          task-definition: ${{ steps.task-def-api.outputs.task-definition }}
          service: ${{ env.ECS_SERVICE_API }}
          cluster: ${{ env.ECS_CLUSTER }}
          wait-for-service-stability: true

      # ─────────────────────────────────────────────────────────
      # Deploy Node-RED Service
      # ─────────────────────────────────────────────────────────
      - name: Download Node-RED task definition
        run: |
          aws ecs describe-task-definition \
            --task-definition vitalsync-nodered \
            --query taskDefinition > task-definition-nodered.json

      - name: Update Node-RED task definition
        id: task-def-nodered
        uses: aws-actions/amazon-ecs-render-task-definition@v1
        with:
          task-definition: task-definition-nodered.json
          container-name: vitalsync-nodered
          image: ${{ needs.build-and-push.outputs.nodered_image }}

      - name: Deploy Node-RED to ECS
        uses: aws-actions/amazon-ecs-deploy-task-definition@v1
        with:
          task-definition: ${{ steps.task-def-nodered.outputs.task-definition }}
          service: ${{ env.ECS_SERVICE_NODERED }}
          cluster: ${{ env.ECS_CLUSTER }}
          wait-for-service-stability: true

      # ─────────────────────────────────────────────────────────
      # Post-Deploy
      # ─────────────────────────────────────────────────────────
      - name: Get Load Balancer URL
        id: get-url
        run: |
          ALB_DNS=$(aws elbv2 describe-load-balancers \
            --names vitalsync-alb \
            --query 'LoadBalancers[0].DNSName' \
            --output text 2>/dev/null || echo "pending")

          echo "url=http://$ALB_DNS" >> $GITHUB_OUTPUT
          echo "Application URL: http://$ALB_DNS"

      - name: Deployment Summary
        run: |
          echo "========================================================"
          echo "           DEPLOYMENT SUCCESSFUL!                       "
          echo "========================================================"
          echo " Environment: ${{ github.event.inputs.environment || 'staging' }}"
          echo " Commit:      ${{ github.sha }}"
          echo " API Image:   ${{ needs.build-and-push.outputs.api_image }}"
          echo " Node-RED:    ${{ needs.build-and-push.outputs.nodered_image }}"
          echo " URL:         ${{ steps.get-url.outputs.url }}"
          echo "========================================================"

  # ═══════════════════════════════════════════════════════════════
  # JOB 4: Notificación (Opcional)
  # ═══════════════════════════════════════════════════════════════
  notify:
    name: Notify Team
    runs-on: ubuntu-latest
    needs: [deploy]
    if: always()

    steps:
      - name: Send notification
        run: |
          if [ "${{ needs.deploy.result }}" == "success" ]; then
            echo "Deployment successful - notifying team..."
            # Aquí puedes agregar Slack, Discord, Email, etc.
          else
            echo "Deployment failed - notifying team..."
          fi
